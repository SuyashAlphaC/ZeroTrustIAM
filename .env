# ─── Server ───
PORT=4000
NODE_ENV=development
USE_MOCK=true
SEED_DEMO=true

# ─── Database ───
DB_PATH=./data/iam.db
# DB_VERBOSE=true
BCRYPT_ROUNDS=12
# Local test container (Postgres on 5433). Used by Jest when TEST_DATABASE_URL is unset.
TEST_DATABASE_URL=postgresql://ztiam:testpassword@127.0.0.1:5433/ztiam_test

# ─── Risk Scoring ───
RISK_THRESHOLD=0.6
RISK_WEIGHT_DEVICE=0.40
RISK_WEIGHT_LOCATION=0.30
RISK_WEIGHT_TIME=0.20
RISK_WEIGHT_ATTEMPTS=0.10

# ─── Anomaly Detection ───
ANOMALY_WEIGHT=0.15
ANOMALY_THRESHOLD=0.4

# ─── MFA ───
MFA_STEP_UP_THRESHOLD=0.3
MFA_ISSUER=ZeroTrustIAM
MFA_CHALLENGE_EXPIRY_SECONDS=300

# ─── JWT (REQUIRED in production) ───
# JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
# JWT_REFRESH_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
# Local-only test secrets (jest setup loads .env so tests pick these up).
JWT_SECRET=test-jwt-secret-minimum-32chars-xx
JWT_REFRESH_SECRET=test-refresh-secret-minimum32chxx
OAUTH_DEFAULT_CLIENT_SECRET=test-client-secret
FABRIC_TEST_MODE=false
ML_SERVICE_ENABLED=false
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=zt-iam-policy-engine

# ─── OAuth / OIDC (REQUIRED in production) ───
OAUTH_ISSUER=http://localhost:4000
OAUTH_CODE_EXPIRY_SECONDS=600
OAUTH_DEFAULT_CLIENT_ID=zt-iam-web
# OAUTH_DEFAULT_CLIENT_SECRET=<generate a strong random secret for production>
OAUTH_CALLBACK_URL=http://localhost:3000/oauth/callback

# ─── WebAuthn ───
WEBAUTHN_RP_NAME=Zero Trust IAM
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
RATE_LIMIT_AUTH_MAX=50

# ─── Logging ───
LOG_LEVEL=info

# ─── Hyperledger Fabric ───
FABRIC_CHANNEL=iamchannel
FABRIC_CHAINCODE=iam-cc
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051

# ─── ZKP ───
ZKP_ENABLED=true

# ─── Cleanup ───
CLEANUP_INTERVAL_MS=300000
POSTGRES_PASSWORD=ztiam-postgres-pass
ML_SERVICE_TOKEN=local-test-ml-token
APP_ENCRYPTION_KEY=ablation-app-encryption-32chars-x
SEED_DEMO=true
