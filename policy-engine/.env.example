# ─── Server ───
PORT=4000
NODE_ENV=development
SEED_DEMO=true        # Set to true ONLY in development to seed alice/bob test users

# ─── Mutual TLS — policy-engine listens on HTTPS ───
# In production NODE_ENV=production, TLS_ENABLED=true is required along with PEM paths below.
# TLS_ENABLED=false
# TLS_KEY_PATH=./path/to/policy-engine-key.pem
# TLS_CERT_PATH=./path/to/policy-engine.pem
# MTLS_CA_PATH=./path/to/ca.pem
#
# Optional: HashiCorp KV hydration before config — requires `curl` in the image / host.
# VAULT_BOOTSTRAP_SYNC=true
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=devroot
# VAULT_SECRET_PATH=secret/data/policy-engine
#
# SECRETS_JSON_PATH=/run/secrets/ztiam-policy.json

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://ztiam:changeme@localhost:5432/ztiam
POSTGRES_PASSWORD=changeme
# TEST_DATABASE_URL=postgresql://ztiam:testpassword@localhost:5432/ztiam_test
BCRYPT_ROUNDS=12

# ─── Risk Scoring ───
RISK_THRESHOLD=0.6
RISK_WEIGHT_DEVICE=0.40
RISK_WEIGHT_LOCATION=0.30
RISK_WEIGHT_TIME=0.20
RISK_WEIGHT_ATTEMPTS=0.10

# ─── Anomaly Detection ───
ANOMALY_WEIGHT=0.15
ANOMALY_THRESHOLD=0.4
# ANOMALY_COLDSTART_MIN_SAMPLES=8
# ANOMALY_COLDSTART_EPSILON=0.12

# ─── MFA ───
MFA_STEP_UP_THRESHOLD=0.3
MFA_ISSUER=ZeroTrustIAM
MFA_CHALLENGE_EXPIRY_SECONDS=300

# ─── JWT (REQUIRED in production) ───
# JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
# JWT_REFRESH_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
# APP_ENCRYPTION_KEY=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=zt-iam-policy-engine

# ─── OAuth / OIDC (REQUIRED in production) ───
OAUTH_ISSUER=http://localhost:4000
OAUTH_CODE_EXPIRY_SECONDS=600
OAUTH_DEFAULT_CLIENT_ID=zt-iam-web
# OAUTH_DEFAULT_CLIENT_SECRET=<generate a strong random secret for production>
OAUTH_CALLBACK_URL=http://localhost:3000/oauth/callback

# ─── WebAuthn ───
WEBAUTHN_RP_NAME=Zero Trust IAM
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
RATE_LIMIT_AUTH_MAX=10

# ─── Logging ───
LOG_LEVEL=info

# ─── Hyperledger Fabric ───
FABRIC_CHANNEL=iamchannel
FABRIC_CHAINCODE=iam-cc
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_ENDPOINT_ORG2=localhost:9051

# ─── ZKP ───
ZKP_ENABLED=true

# ─── ML Risk Scoring Sidecar (Python FastAPI) ───
ML_SERVICE_ENABLED=true
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_TIMEOUT_MS=800
ML_SERVICE_TOKEN=dev-ml-service-token

# Ensemble weights — AHP + ML + anomaly. Must sum to 1.
# If the ML sidecar is unavailable, ML weight is redistributed to AHP + anomaly.
ENSEMBLE_AHP_WEIGHT=0.4
ENSEMBLE_ML_WEIGHT=0.4
ENSEMBLE_ANOMALY_WEIGHT=0.2

# ─── Cleanup ───
CLEANUP_INTERVAL_MS=300000
