# docker-compose interpolation ONLY. Compose passes its own `environment:` to each service.
# Do NOT put NODE_ENV / FABRIC_TEST_MODE / SEED_DEMO / USE_MOCK here — compose overrides them
# anyway, and this file is also picked up by `npm start` outside compose where those flags
# would silently switch the policy-engine into mock mode.
POSTGRES_PASSWORD=ztiam-postgres-pass
ML_SERVICE_TOKEN=local-test-ml-token
APP_ENCRYPTION_KEY=ablation-app-encryption-32chars-x
JWT_SECRET=test-jwt-secret-minimum-32chars-xx
JWT_REFRESH_SECRET=test-refresh-secret-minimum32chxx
OAUTH_DEFAULT_CLIENT_SECRET=test-client-secret
